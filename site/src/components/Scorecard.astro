---
/**
 * The 28 rubric criteria as one grid: a row per domain, a cell per criterion,
 * shaded by the grader's automated estimate (0, 1, 2 or N/A). Gating criteria
 * are ringed; a ring turns amber when the estimate is below the gate.
 * Data comes straight from ai-ready-evidence.json; nothing is derived.
 */
interface Criterion { id: string; name: string; score: number | null; gate_min?: number | null }
interface Domain { title: string; gating: boolean; criteria: Criterion[] }
interface Props { dataset: string; rubric: string; domains: Domain[]; reviewHref: string }
const { dataset, rubric, domains, reviewHref } = Astro.props;

const failedGates = domains.flatMap((d) =>
  d.criteria.filter((c) => c.gate_min != null && c.score != null && c.score < c.gate_min),
);
function label(c: Criterion) {
  const s = c.score == null ? 'N/A' : `${c.score} of 2`;
  const g = c.gate_min != null ? ` · gate: needs ${c.gate_min}` : '';
  return `${c.id} ${c.name} — ${s}${g}`;
}
---

<figure class="fs-score not-content">
  <div class="head">
    <div>
      <strong>Automated estimate per criterion</strong>
      <span class="ds">{dataset}</span>
    </div>
    <span class={`gate-status ${failedGates.length ? 'fail' : 'pass'}`}>
      {failedGates.length
        ? `Gating FAIL · ${failedGates.map((c) => `${c.id} scored ${c.score}, needs ${c.gate_min}`).join('; ')}`
        : 'All gates pass'}
    </span>
  </div>

  <div class="grid" role="table" aria-label="AI-readiness estimate by criterion">
    {domains.map((d) => {
      const scored = d.criteria.filter((c) => c.score != null);
      const earned = scored.reduce((n, c) => n + (c.score ?? 0), 0);
      return (
        <div class="row" role="row">
          <span class="domain" role="rowheader">{d.title}</span>
          <span class="cells" role="cell">
            {d.criteria.map((c) => (
              <span
                class:list={['cell', c.score == null ? 'na' : `s${c.score}`, { gate: c.gate_min != null, fail: c.gate_min != null && c.score != null && c.score < c.gate_min }]}
                title={label(c)}
              >
                <i></i>
                <small>{c.id}</small>
              </span>
            ))}
          </span>
          <span class="sum" role="cell">{earned}/{scored.length * 2}</span>
        </div>
      );
    })}
  </div>

  <div class="legend">
    <span><i class="sw s0"></i>0</span>
    <span><i class="sw s1"></i>1</span>
    <span><i class="sw s2"></i>2</span>
    <span><i class="sw na"></i>N/A</span>
    <span><i class="sw gate"></i>gating criterion</span>
    <span><i class="sw gate fail"></i>below gate</span>
  </div>
  <figcaption>
    {rubric}. Estimates come from the metadata alone; a person or an LLM makes the final call.
    <a href={reviewHref} target="_blank" rel="noopener">See the full review</a>, which lists the evidence behind every cell.
  </figcaption>
</figure>

<style>
  .fs-score {
    --s0: #d9ebee;
    --s1: #3a9ea6;
    --s2: #005f73;
    --na: transparent;
    --gate: var(--sl-color-gray-2);
    --fail: #c77a00;
    margin: 1.5rem 0;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    padding: 0.9rem 1rem 0.75rem;
    background: var(--sl-color-bg);
    font-size: var(--sl-text-sm);
  }
  :global(:root[data-theme='dark']) .fs-score {
    --s0: #1d4d55;
    --s1: #2faab6;
    --s2: #a8e3e9;
    --fail: #f0a830;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 0.9rem;
  }
  .head strong { display: block; color: var(--sl-color-white); }
  .ds { color: var(--sl-color-gray-2); }
  .gate-status {
    align-self: flex-start;
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    font-weight: 600;
    white-space: nowrap;
    border: 1px solid currentColor;
  }
  .gate-status.fail { color: var(--fail); }
  .gate-status.pass { color: var(--s2); }

  .grid { display: flex; flex-direction: column; gap: 0.45rem; }
  .row {
    display: grid;
    grid-template-columns: 11rem 1fr 3rem;
    align-items: center;
    gap: 0.75rem;
  }
  .domain { color: var(--sl-color-white); font-weight: 500; }
  .sum { text-align: right; color: var(--sl-color-gray-2); font-variant-numeric: tabular-nums; }
  .cells { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    width: 2.1rem;
  }
  .cell i, .sw {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 4px;
    border: 1px solid var(--sl-color-hairline);
    box-sizing: border-box;
  }
  .cell small { font-size: 0.68rem; color: var(--sl-color-gray-3); line-height: 1; }
  .s0 i, .sw.s0 { background: var(--s0); }
  .s1 i, .sw.s1 { background: var(--s1); }
  .s2 i, .sw.s2 { background: var(--s2); }
  .na i, .sw.na { background: var(--na); border-style: dashed; }
  .gate i, .sw.gate { box-shadow: 0 0 0 2px var(--sl-color-bg), 0 0 0 4px var(--gate); }
  .fail i, .sw.fail { box-shadow: 0 0 0 2px var(--sl-color-bg), 0 0 0 4px var(--fail); }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    margin-top: 1.1rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-2);
  }
  .legend span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .legend .sw { width: 0.9rem; height: 0.9rem; border-radius: 3px; }
  figcaption { margin-top: 0.6rem; color: var(--sl-color-gray-2); line-height: 1.5; }
  figcaption a { color: var(--sl-color-accent-high); }

  @media (max-width: 40rem) {
    .row { grid-template-columns: 1fr 3rem; }
    .domain { grid-column: 1 / -1; }
  }
</style>
