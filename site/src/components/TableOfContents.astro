---
import Default from '@astrojs/starlight/components/TableOfContents.astro';

const { toc } = Astro.props;
const onThisPage = Astro.locals.t('tableOfContents.onThisPage');
---

{toc && (
  <details class="fs-toc">
    <summary>{onThisPage}</summary>
    <div class="fs-toc-body">
      <Default {...Astro.props}><slot /></Default>
    </div>
  </details>
)}

<style is:global>
  .fs-toc {
    font-size: var(--sl-text-xs);
  }
  .fs-toc summary {
    cursor: pointer;
    font-weight: 600;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-white);
    list-style: none;
    padding: 0.25rem 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .fs-toc summary::-webkit-details-marker {
    display: none;
  }
  .fs-toc summary::before {
    content: '▸';
    display: inline-block;
    transition: transform 0.15s ease;
    color: var(--sl-color-gray-3);
    font-size: 0.75em;
  }
  .fs-toc[open] summary::before {
    transform: rotate(90deg);
  }
  /* Hide the default "On this page" heading rendered by the wrapped Default component */
  .fs-toc-body starlight-toc h2 {
    display: none;
  }
  .fs-toc-body starlight-toc nav {
    padding-top: 0.25rem;
  }
</style>
